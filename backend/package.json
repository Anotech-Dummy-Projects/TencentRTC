{
  "name": "backend",
  "version": "1.0.0",
  "description": "User authentication backend",
  "scripts": {
    "dev": "nodemon",
    "dev:tsx": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit"
  },
  "nodemonConfig": {
    "exec": "tsx src/index.ts",
    "ext": "ts,json",
    "watch": [
      "src"
    ],
    "ignore": [
      "dist",
      "node_modules"
    ],
    "env": {
      "NODE_ENV": "development"
    }
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.3",
    "tls-sig-api-v2": "^1.0.2",
    "tls-sig-api-v2-typescript": "^1.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "nodemon": "^3.1.14",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
